# Phone Bridge 配置
# 不配也能跑——所有项都有默认值

# === AI 后端 (三选一) ===
# AI_BACKEND=claude      # Claude Code CLI (免费, 需安装Claude Code)
# AI_BACKEND=codex       # OpenAI Codex CLI (免费, npm install -g @openai/codex)
# AI_BACKEND=api         # 直接调 API (DeepSeek/OpenAI/Groq)

# === API 模式配置 (仅 AI_BACKEND=api 时需要) ===
# API_KEY=sk-xxx
# API_BASE=https://api.deepseek.com
# API_MODEL=deepseek-chat

# === 通用配置 ===
# WORK_DIR=.              # AI 能访问的工作目录
# SYSTEM_PROMPT=你是AI助手。回复用中文，简洁直接。
# AI_TIMEOUT=300          # AI 超时 (秒)
# PORT=9010               # Web 服务端口
