# Phone Bridge 配置文件
# 复制为 .env 后修改
# cp .env.example .env

# 工作目录 (引擎和交易数据所在)
WORK_DIR=C:\MyProject\返璞量化

# AI 后端: claude | codex | api
AI_BACKEND=claude

# AI 超时 (秒)
AI_TIMEOUT=300

# 访问控制: 允许的企业微信用户ID列表, 逗号分隔. 空=不限制
ALLOWED_USERS=

# Web 服务端口
PORT=9010

# === 以下仅 AI_BACKEND=api 时需要 ===
API_KEY=sk-xxx
API_BASE=https://api.deepseek.com
API_MODEL=deepseek-chat
